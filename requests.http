POST https://localhost:8443/api/editorial-comments/{{c3Id}}/dismiss
Authorization: Basic {{editorEmail}} {{userPassword}}
X-XSRF-TOKEN: {{csrfToken}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    const body = response.body;
    client.test("Замечание снято", () => client.assert(body.status === "REJECTED"));
%}

### Анна утверждает последний сегмент → проект в REVIEW
POST https://localhost:8443/api/translations/{{t2Id}}/approve
Authorization: Basic {{editorEmail}} {{userPassword}}
X-XSRF-TOKEN: {{csrfToken}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    const body = response.body;
    client.test("Проект в REVIEW", () => client.assert(body.project.status === "REVIEW"));
%}

