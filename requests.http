### ================= 2. Состояние учётной записи =================
### После 5 неверных паролей подряд учётная запись блокируется на 15 минут. Администратор может заблокировать пользователя и снять любую блокировку.

### Гость меняет пароль
POST https://localhost:8443/api/auth/password
Authorization: Basic {{guestEmail}} {{guestPassword}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "currentPassword": "{{guestPassword}}",
  "newPassword": "N3w#Guest{{runId}}"
}

> {%
    client.test("HTTP 204", () => client.assert(response.status === 204, "Ожидался 204, получен " + response.status));
    client.global.set("guestPassword", "N3w#Guest" + client.global.get("runId"));
%}

### ✗ Неверный текущий пароль → 400
POST https://localhost:8443/api/auth/password
Authorization: Basic {{guestEmail}} {{guestPassword}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "currentPassword": "Wrong#Password1",
  "newPassword": "An0ther#Pass"
}

> {%
    client.test("HTTP 400", () => client.assert(response.status === 400, "Ожидался 400, получен " + response.status));
%}

