### ================= 3. Проекты — CRUD =================
### Создавать проекты может редактор, он же становится владельцем. Менять проект может только владелец.

### ✗ Переводчик создаёт проект → 403
POST https://localhost:8443/api/translation-projects
Authorization: Basic {{translatorEmail}} {{userPassword}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Свой проект",
  "targetLanguage": "en"
}

> {%
    client.test("HTTP 403", () => client.assert(response.status === 403, "Ожидался 403, получен " + response.status));
%}

### ✗ Статус напрямую → 400
POST https://localhost:8443/api/translation-projects
Authorization: Basic {{editorEmail}} {{userPassword}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Хитрый проект",
  "targetLanguage": "en",
  "status": "COMPLETED"
}

> {%
    client.test("HTTP 400", () => client.assert(response.status === 400, "Ожидался 400, получен " + response.status));
%}

### Анна создаёт проект
POST https://localhost:8443/api/translation-projects
Authorization: Basic {{editorEmail}} {{userPassword}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Локализация сайта {{runId}}",
  "targetLanguage": "en"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    const body = response.body;
    client.test("Владелец — Анна", () => client.assert(body.ownerId == client.global.get("editorId")));
    client.test("DRAFT", () => client.assert(body.status === "DRAFT"));
    client.global.set("projectId", body.id);
%}

### Анна создаёт пустой проект
POST https://localhost:8443/api/translation-projects
Authorization: Basic {{editorEmail}} {{userPassword}}
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Пустой проект {{runId}}",
  "targetLanguage": "de"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    const body = response.body;
    client.global.set("emptyProjectId", body.id);
%}

