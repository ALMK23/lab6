### Вариант 16. Согласование переводов — лаба 4: аутентификация и авторизация.
### Выполняйте запросы сверху вниз (или «Run All Requests in File»): id и CSRF-токен сохраняются в переменные.
### Запросы с «✗» — негативные проверки, они ДОЛЖНЫ вернуть ошибку.
### Пользователь запроса задаётся заголовком Authorization: Basic <email> <пароль>.
### Администратор admin@demo.local / Admin#2024 создаётся миграцией V3.

### ================= 0. Аутентификация и CSRF =================
### HTTP Basic: email и пароль в каждом запросе. Для POST / PATCH / DELETE нужен CSRF-токен: GET /api/auth/csrf ставит cookie XSRF-TOKEN и возвращает токен, его передаём в заголовке X-XSRF-TOKEN.

### Получить CSRF-токен
< {%
    client.global.set("runId", Date.now().toString());
    const runId = client.global.get("runId");
    client.global.set("adminEmail", "admin@demo.local");
    client.global.set("adminPassword", "Admin#2024");
    client.global.set("seedEditorEmail", "anna.editor@demo.local");
    client.global.set("seedEditorPassword", "Editor#2024");
    client.global.set("userPassword", "Str0ng#Pass2024");
    client.global.set("editorEmail", "anna." + runId + "@example.com");
    client.global.set("editor2Email", "dmitry." + runId + "@example.com");
    client.global.set("translatorEmail", "boris." + runId + "@example.com");
    client.global.set("translator2Email", "vera." + runId + "@example.com");
    client.global.set("guestEmail", "guest." + runId + "@example.com");
    client.global.set("guestPassword", "Str0ng#Pass2024");
%}
GET https://localhost:8443/api/auth/csrf

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    const body = response.body;
    client.test("Заголовок X-XSRF-TOKEN", () => client.assert(body.headerName === "X-XSRF-TOKEN"));
    client.test("Токен выдан", () => client.assert(!!body.token));
    client.global.set("csrfToken", body.token);
%}

### ✗ Запрос без логина → 401
GET https://localhost:8443/api/translation-projects

> {%
    client.test("HTTP 401", () => client.assert(response.status === 401, "Ожидался 401, получен " + response.status));
    const body = response.body;
    client.test("Понятное сообщение", () => client.assert(body.message.includes("аутентификация")));
%}

### ✗ Неверный пароль → 401
GET https://localhost:8443/api/auth/me
Authorization: Basic {{adminEmail}} Wrong#Password1

> {%
    client.test("HTTP 401", () => client.assert(response.status === 401, "Ожидался 401, получен " + response.status));
    const body = response.body;
    client.test("Без подробностей, какой именно email", () => client.assert(!body.message.includes("admin")));
%}

### ✗ Несуществующий пользователь → 401 (такой же ответ)
GET https://localhost:8443/api/auth/me
Authorization: Basic nobody.{{runId}}@example.com Wrong#Password1

> {%
    client.test("HTTP 401", () => client.assert(response.status === 401, "Ожидался 401, получен " + response.status));
%}

### Вход администратора (из миграции)
GET https://localhost:8443/api/auth/me
Authorization: Basic {{adminEmail}} {{adminPassword}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    const body = response.body;
    client.test("Роль ADMIN", () => client.assert(body.role === "ADMIN"));
    client.global.set("adminId", body.id);
%}

### Вход тестового редактора (из миграции)
GET https://localhost:8443/api/auth/me
Authorization: Basic {{seedEditorEmail}} {{seedEditorPassword}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    const body = response.body;
    client.test("Роль EDITOR", () => client.assert(body.role === "EDITOR"));
%}

### Тестовые проекты из миграции
GET https://localhost:8443/api/translation-projects
Authorization: Basic {{seedEditorEmail}} {{seedEditorPassword}}

> {%
    client.test("HTTP 200", () => client.assert(response.status === 200, "Ожидался 200, получен " + response.status));
    const body = response.body;
    client.test("Массив", () => client.assert(Array.isArray(body)));
%}

### ✗ Регистрация без CSRF-токена → 403
POST https://localhost:8443/api/auth/register
Content-Type: application/json

{
  "name": "Без токена",
  "email": "nocsrf.{{runId}}@example.com",
  "password": "{{userPassword}}"
}

> {%
    client.test("HTTP 403", () => client.assert(response.status === 403, "Ожидался 403, получен " + response.status));
    const body = response.body;
    client.test("Сообщение про CSRF", () => client.assert(body.message.includes("CSRF")));
%}

### ✗ Поддельный CSRF-токен → 403
POST https://localhost:8443/api/auth/register
Content-Type: application/json
X-XSRF-TOKEN: fake-token

{
  "name": "Подделка",
  "email": "fake.{{runId}}@example.com",
  "password": "{{userPassword}}"
}

> {%
    client.test("HTTP 403", () => client.assert(response.status === 403, "Ожидался 403, получен " + response.status));
%}

### ================= 1. Регистрация и пользователи =================
### Переводчики регистрируются сами (роль всегда TRANSLATOR), редакторов создаёт администратор.

### Борис регистрируется
POST https://localhost:8443/api/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Борис",
  "email": "{{translatorEmail}}",
  "password": "{{userPassword}}"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    const body = response.body;
    client.test("Роль TRANSLATOR", () => client.assert(body.role === "TRANSLATOR"));
    client.test("Хеш пароля не отдаётся", () => client.assert(body.passwordHash === undefined && body.password === undefined));
    client.global.set("translatorId", body.id);
%}

### Вера регистрируется и пытается стать ADMIN
POST https://localhost:8443/api/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Вера Лингвистова",
  "email": "{{translator2Email}}",
  "password": "{{userPassword}}",
  "role": "ADMIN"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    const body = response.body;
    client.test("Роль всё равно TRANSLATOR", () => client.assert(body.role === "TRANSLATOR"));
    client.global.set("translator2Id", body.id);
%}

### Гость регистрируется
POST https://localhost:8443/api/auth/register
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "name": "Гость",
  "email": "{{guestEmail}}",
  "password": "{{guestPassword}}"
}

> {%
    client.test("HTTP 201", () => client.assert(response.status === 201, "Ожидался 201, получен " + response.status));
    const body = response.body;
    client.global.set("tmpUserId", body.id);
%}

